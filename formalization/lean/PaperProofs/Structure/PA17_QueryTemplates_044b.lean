module
public import PaperProofs.Structure.PA17_QueryTemplates_044a
public import PaperProofs.Structure.PA17_QueryHeader_009

/-! Fixed actual Header009 template, including its genuine N=0 branch.
The branch is generated by a 0/1 bounded repeat, not an oracle code input. -/
@[expose] public section
set_option maxRecDepth 20000
set_option maxHeartbeats 1000000
namespace PaperProofs.Structure.LaminarTree.PA17QueryTemplates044b

open IndexedRAM IndexedClosureRAM AlgorithmClaims PA17UniformGenerator035b PA17UniformGenerator035d PA17ProgramTemplates041

local instance (n : Nat) : OfNat Expr n := ⟨.constant n⟩
local instance : HAdd Expr Expr Expr := ⟨.binary .add⟩
local instance : HSub Expr Expr Expr := ⟨.binary .subtract⟩
local instance : HMul Expr Expr Expr := ⟨.binary .multiply⟩

def save (target : Expr) (source : Register) : Program := .code [.constant .index target, .storeHeap .index source]
def set (target value : Expr) : Program := .code [.constant .index target, .constant .value value, .storeHeap .index .value]
def addLoop (count : Expr) : Program := .repeat 20 count (.code [.add .total .total .old])

theorem save_eval (target : Expr) (source : Register) (N q size : Nat) (environment : Nat → Nat) :
    (save target source).eval (dimensionROM N q size) environment = PA17QueryHeader009.save (target.eval (dimensionROM N q size) environment) source := by
  simp [save, Program.eval, instructions, OpExpr.eval, OpExpr.storeHeap, PA17QueryHeader009.save]

theorem set_eval (target value : Expr) (N q size : Nat) (environment : Nat → Nat) :
    (set target value).eval (dimensionROM N q size) environment = PA17QueryHeader009.set
      (target.eval (dimensionROM N q size) environment) (value.eval (dimensionROM N q size) environment) := by
  simp [set, Program.eval, instructions, OpExpr.eval, OpExpr.storeHeap, PA17QueryHeader009.set, IndexedCellRAM.constantBlock]

theorem addLoop_eval (count : Expr) (N q size : Nat) (environment : Nat → Nat) :
    (addLoop count).eval (dimensionROM N q size) environment = PA17QueryHeader009.addLoop (count.eval (dimensionROM N q size) environment) :=
  repeat_eval_replicate 20 count (.base (.add .total .total .old)) _ _ _ rfl

def readStage (head : Expr) : Program := .append
  (.code [.constant .index (3 + nDim * qDim + tDim * qDim), .loadROM .input .old .index]) (save (head + 3) .old)

theorem readStage_eval (head : Expr) (N q size : Nat) (environment : Nat → Nat) :
    (readStage head).eval (dimensionROM N q size) environment = PA17QueryHeader009.readStage N q size (head.eval (dimensionROM N q size) environment) := by
  rw [readStage, Program.eval, save_eval]
  rfl

def activeInit : Program := .code [.constant .total nDim, .subtract .total .total .old,
  .constant .fresh 1, .constant .address 0, .select .flag .total .fresh .address]

theorem activeInit_eval (N q size : Nat) (environment : Nat → Nat) :
    activeInit.eval (dimensionROM N q size) environment = PA17QueryHeader009.activeInit N := by
  simp [activeInit, Program.eval, instructions, OpExpr.eval, OpExpr.subtract, OpExpr.select, PA17QueryHeader009.activeInit,
    Expr.eval, nDim, dimensionROM, PhysicalROM.semantic, PhysicalROM.words]

def rowProgram (head : Expr) : Program := Program.sequence [activeInit, save (head + 2) .flag,
  .code [.constant .fresh 1, .add .old .old .fresh, .constant .total 0],
  addLoop ((qDim + 2) * (tDim + 1)), .code [.select .total .flag .total .address], save head .total]

theorem rowProgram_eval (head : Expr) (N q size : Nat) (environment : Nat → Nat) :
    (rowProgram head).eval (dimensionROM N q size) environment = PA17QueryHeader009.rowProgram N q size (head.eval (dimensionROM N q size) environment) := by
  simp only [rowProgram, Program.sequence_eval, List.flatMap_cons, List.flatMap_nil, List.append_nil]
  rw [activeInit_eval, save_eval, addLoop_eval, save_eval]
  simp only [PA17QueryHeader009.rowProgram, List.append_assoc]
  rfl

def stageStart (head : Expr) : Program := Program.sequence [
  .code [.constant .index (head + 3), .loadHeap .old .index, .constant .fresh (nDim - 1),
    .minimum .old .old .fresh, .constant .total 3], addLoop qDim, save (head + 8) .total]

theorem stageStart_eval (head : Expr) (N q size : Nat) (environment : Nat → Nat) :
    (stageStart head).eval (dimensionROM N q size) environment = PA17QueryHeader009.stageStartProgram N q (head.eval (dimensionROM N q size) environment) := by
  simp only [stageStart, Program.sequence_eval, List.flatMap_cons, List.flatMap_nil, List.append_nil]
  rw [addLoop_eval, save_eval]
  rfl

def headerBit (row node tool : Expr) : Program := .code [
  .constant .address row, .loadHeap .index .address, .constant .old tool, .add .index .index .old, .loadROM .input .old .index,
  .constant .index (3 + nDim * qDim + node * qDim + tool), .loadROM .input .fresh .index,
  .subtract .flag .old .fresh, .subtract .index .fresh .old, .add .flag .flag .index, .add .total .total .flag]

theorem headerBit_eval (row node tool : Expr) (N q size : Nat) (environment : Nat → Nat) :
    (headerBit row node tool).eval (dimensionROM N q size) environment = PA17QueryHeader009.bitBlock N q
      (row.eval (dimensionROM N q size) environment) (node.eval (dimensionROM N q size) environment) (tool.eval (dimensionROM N q size) environment) := by
  simp [headerBit, Program.eval, instructions, OpExpr.eval, OpExpr.loadHeap, OpExpr.loadROM, OpExpr.add, OpExpr.subtract,
    PA17QueryHeader009.bitBlock, Expr.eval, Binary.eval, nDim, qDim, dimensionROM, PhysicalROM.semantic, PhysicalROM.words]

def headerTail (node : Expr) : Program := .code [.constant .old (node + 1), .select .value .total .value .old]

theorem headerTail_eval (node : Expr) (N q size : Nat) (environment : Nat → Nat) :
    (headerTail node).eval (dimensionROM N q size) environment = PA17StageMap001.nodeTail (node.eval (dimensionROM N q size) environment) := by
  simp [headerTail, Program.eval, instructions, OpExpr.eval, OpExpr.select, PA17StageMap001.nodeTail, Expr.eval, Binary.eval]

def headerNode (row node : Expr) : Program := Program.sequence [.code [.constant .total 0],
  .repeat 19 qDim (headerBit row node (qDim - .cell 19)), headerTail node]

theorem headerNode_eval (row node : Expr) (hrow : 19 ∉ row.cells) (hnode : 19 ∉ node.cells)
    (N q size : Nat) (environment : Nat → Nat) :
    (headerNode row node).eval (dimensionROM N q size) environment = PA17QueryHeader009.nodeBlock N q
      (row.eval (dimensionROM N q size) environment) (node.eval (dimensionROM N q size) environment) := by
  have hloop : (Program.repeat 19 qDim (headerBit row node (qDim - .cell 19))).eval (dimensionROM N q size) environment =
      (List.range q).flatMap (PA17QueryHeader009.bitBlock N q (row.eval (dimensionROM N q size) environment) (node.eval (dimensionROM N q size) environment)) := by
    apply repeat_eval_ascending 19 qDim _ _ _ q rfl
    intro tool ht
    rw [headerBit_eval]
    change PA17QueryHeader009.bitBlock N q (row.eval _ (Function.update environment 19 (q - tool)))
      (node.eval _ (Function.update environment 19 (q - tool))) (q - (q - tool)) = _
    rw [eval_update_of_not_mem row _ environment 19 (q - tool) hrow,
      eval_update_of_not_mem node _ environment 19 (q - tool) hnode, Nat.sub_sub_self ht.le]
  simp only [headerNode, Program.sequence_eval, List.flatMap_cons, List.flatMap_nil, List.append_nil]
  rw [hloop, headerTail_eval]
  rfl

def headerNodes (row : Expr) : Program := .repeat 18 tDim (headerNode row (tDim - .cell 18))

theorem headerNodes_eval (row : Expr) (hrow : row.cells = ∅) (N q size : Nat) (environment : Nat → Nat) :
    (headerNodes row).eval (dimensionROM N q size) environment = (List.range size).flatMap
      (PA17QueryHeader009.nodeBlock N q (row.eval (dimensionROM N q size) environment)) := by
  apply repeat_eval_ascending 18 tDim _ _ _ size rfl
  intro node hn
  rw [headerNode_eval row _ (by simp [hrow]) (by decide)]
  change PA17QueryHeader009.nodeBlock N q (row.eval _ (Function.update environment 18 (size - node))) (size - (size - node)) = _
  rw [eval_update_of_not_mem row _ environment 18 (size - node) (by simp [hrow]), Nat.sub_sub_self hn.le]

def scanProgram (row : Expr) : Program := .append (.code [.constant .value 0])
  (.repeat 20 (.binary .minimum nDim 1) (headerNodes row))

theorem scanProgram_eval (row : Expr) (hrow : row.cells = ∅) (N q size : Nat) (environment : Nat → Nat) :
    (scanProgram row).eval (dimensionROM N q size) environment = PA17QueryHeader009.scanProgram N q size (row.eval (dimensionROM N q size) environment) := by
  simp only [scanProgram, Program.eval, instructions, List.map_cons, List.map_nil, OpExpr.eval]
  change [.base (.constant .value 0)] ++
    (List.range (min N 1)).reverse.flatMap (fun index => (headerNodes row).eval (dimensionROM N q size) (Function.update environment 20 (index + 1))) = _
  by_cases hN : N = 0
  · subst N
    rfl
  · have hmin : min N 1 = 1 := by omega
    rw [hmin]
    simp only [List.range_succ, List.range_zero, List.nil_append, List.reverse_cons, List.reverse_nil,
      List.flatMap_cons, List.flatMap_nil, List.append_nil, headerNodes_eval row hrow]
    rw [eval_update_of_not_mem row _ environment 20 1 (by simp [hrow])]
    simp only [PA17QueryHeader009.scanProgram, hN, ite_false]

def finish (head : Expr) : Program := Program.sequence [
  .code [.constant .index (head + 2), .loadHeap .flag .index, .constant .old 0, .select .value .flag .value .old],
  save (head + 1) .value, set (head + 4) 0, set (head + 5) 0, set (head + 6) 0, set (head + 7) 0]

theorem finish_eval (head : Expr) (N q size : Nat) (environment : Nat → Nat) :
    (finish head).eval (dimensionROM N q size) environment = PA17QueryHeader009.finish (head.eval (dimensionROM N q size) environment) := by
  simp [finish, Program.sequence_eval, Program.eval, save_eval, set_eval, instructions, OpExpr.eval,
    OpExpr.loadHeap, OpExpr.select, PA17QueryHeader009.finish, Expr.eval, Binary.eval, List.append_assoc]

def headerProgram (head : Expr) : Program := Program.sequence [readStage head, rowProgram head, stageStart head, scanProgram (head + 8), finish head]

theorem headerProgram_eval (head : Expr) (hhead : head.cells = ∅) (N q size : Nat) (environment : Nat → Nat) :
    (headerProgram head).eval (dimensionROM N q size) environment = PA17QueryHeader009.program N q size (head.eval (dimensionROM N q size) environment) := by
  simp only [headerProgram, Program.sequence_eval, List.flatMap_cons, List.flatMap_nil, List.append_nil]
  rw [readStage_eval, rowProgram_eval, stageStart_eval, scanProgram_eval _ (by simp [Expr.cells, hhead]), finish_eval]
  simp only [Expr.eval, Binary.eval, PA17QueryHeader009.program, List.append_assoc]

theorem headerProgram_uniformLength (head : Expr) : (headerProgram head).UniformLength := by
  dsimp [Program.UniformLength, Program.lengthExpr, Program.sequence, headerProgram, readStage, rowProgram, stageStart,
    scanProgram, headerNodes, headerNode, headerBit, headerTail, finish, save, set, addLoop, activeInit,
    Expr.cells, nDim, qDim, tDim]
  decide

end PaperProofs.Structure.LaminarTree.PA17QueryTemplates044b
