/-! The canonical theorem modules are imported all; their private interfaces
are NOT imported all. Interface definition/rfl body audits are separate.
Only actual canonical owners enter the new-declaration/Std3 audit. -/
set_option autoImplicit false
set_option warningAsError true
set_option maxHeartbeats 2000000
set_option maxRecDepth 10000

example : PaperProofs.Common.Native.B23PaperClosure.FullPaperClaims :=
  PaperProofs.Common.Native.B23PaperClosure.full_paper_claims
example : PaperProofs.Structure.LaminarTree.L01PaperClosure.FullPaperClaims :=
  PaperProofs.Structure.LaminarTree.L01PaperClosure.full_paper_claims
example : PaperProofs.Structure.LaminarTree.CompactControllerClaims.FullClaims.{0} :=
  PaperProofs.Structure.LaminarTree.CompactControllerA19Closure.fullClaims.{0}
example : PaperProofs.Structure.LaminarTree.CompactControllerClaims.CallbackClaims :=
  PaperProofs.Structure.LaminarTree.PSTRCallback.callbackClaims
example : PaperProofs.Structure.LaminarTree.CompactControllerClaims.NativeCallbackClaims :=
  PaperProofs.Structure.LaminarTree.PSTRCallback.nativeCallbackClaims

open Lean Elab Command
run_cmd do
  let env := (← getEnv).setExporting false
  let formal := env.header.modules.filter fun entry => (`PaperProofs).isPrefixOf entry.module
  unless formal.size == 1923 && env.header.modules.size >= formal.size do
    throwError m!"NORMAL_FULL013_FAIL formal_modules={formal.size} total_modules={env.header.modules.size} expected=1923"
  let owners := #[`PaperProofs.Common.B23PaperClosure, `PaperProofs.Structure.L01PaperClosure]
  let ownerOf := fun name : Name =>
    match env.getModuleIdxFor? name with
    | none => none
    | some index =>
      match env.header.modules[index.toNat]? with
      | none => none
      | some entry => some entry.module
  let headerKind := fun info : ConstantInfo =>
    match info with
    | .axiomInfo _ => "axiomInfo"
    | .defnInfo _ => "defnInfo"
    | .thmInfo _ => "thmInfo"
    | .opaqueInfo _ => "opaqueInfo"
    | _ => "other"
  for (owner, specification, interfaceOwner, theoremName) in #[
      (`PaperProofs.Common.B23PaperClosure,
       `PaperProofs.Common.Native.B23PaperClosure.FullPaperClaims,
       `RootPaper_B23_Interface007,
       `PaperProofs.Common.Native.B23PaperClosure.full_paper_claims),
      (`PaperProofs.Structure.L01PaperClosure,
       `PaperProofs.Structure.LaminarTree.L01PaperClosure.FullPaperClaims,
       `RootPaper_L01_Interface006,
       `PaperProofs.Structure.LaminarTree.L01PaperClosure.full_paper_claims)] do
    let canonicalModules := env.header.modules.filter fun entry => entry.module == owner
    unless canonicalModules.size == 1 do throwError m!"NORMAL_FULL013_FAIL canonical_module={owner}"
    for entry in canonicalModules do
      unless entry.importAll && entry.hasData do throwError m!"NORMAL_FULL013_FAIL canonical_private_data={owner}"
    unless ownerOf theoremName == some owner do throwError m!"NORMAL_FULL013_FAIL theorem_owner={theoremName}"
    match env.find? theoremName with
    | some info =>
      unless info.type == mkConst specification do throwError m!"NORMAL_FULL013_FAIL exact_theorem_type={theoremName}"
    | none => throwError m!"NORMAL_FULL013_FAIL missing_theorem={theoremName}"
    unless ownerOf specification == some interfaceOwner do throwError m!"NORMAL_FULL013_FAIL spec_owner={specification}"
    let interfaceModules := env.header.modules.filter fun entry => entry.module == interfaceOwner
    unless interfaceModules.size == 1 do throwError m!"NORMAL_FULL013_FAIL interface_module={interfaceOwner}"
    for entry in interfaceModules do
      unless !entry.importAll do throwError m!"NORMAL_FULL013_FAIL interface_must_not_import_all={interfaceOwner}"
      match env.find? specification with
      | some info =>
        unless info.type == mkSort .zero do throwError m!"NORMAL_FULL013_FAIL spec_not_Prop={specification}"
        logInfo m!"NORMAL_FULL013_INTERFACE_HEADER spec={specification} owner={interfaceOwner} kind={headerKind info} type=Prop importAll={entry.importAll} hasData={entry.hasData} body_not_forced=true"
      | none => throwError m!"NORMAL_FULL013_FAIL missing_spec={specification}"
    logInfo m!"NORMAL_FULL013_CANONICAL_THEOREM name={theoremName} owner={owner} exact_type={specification} importAll=true hasData=true"
  let header := `PaperProofs.Common.Native.RationalControllerComputation.PSTRTMHeader003.headerTrace._f
  unless ownerOf header == some `PaperProofs.Common.PSTR_TM_Header_003 do
    throwError m!"NORMAL_FULL013_FAIL old_Header003_owner={ownerOf header}"
  logInfo "NORMAL_FULL013_OLD_HEADER_OWNER_PASS owner=PaperProofs.Common.PSTR_TM_Header_003"

  let declarations := env.constants.toList.filter fun (name, _) =>
    match ownerOf name with
    | some owner => owners.contains owner
    | none => false
  let allowed := #[`propext, `Classical.choice, `Quot.sound]
  for owner in owners do
    let own := declarations.filter fun (name, _) => ownerOf name == some owner
    unless own.length > 0 do throwError m!"NORMAL_FULL013_FAIL empty_canonical_owner={owner}"
    let mut theoremCount : Nat := 0
    let mut definitionCount : Nat := 0
    let mut privateCount : Nat := 0
    for (name, info) in own do
      if isPrivateName name then privateCount := privateCount + 1
      match info with
      | .axiomInfo _ => throwError m!"NORMAL_FULL013_NEW_OWN_AXIOM owner={owner} name={name}"
      | .thmInfo _ => theoremCount := theoremCount + 1
      | .defnInfo _ => definitionCount := definitionCount + 1
      | _ => pure ()
      for axiomName in ← collectAxioms name do
        unless allowed.contains axiomName do
          throwError m!"NORMAL_FULL013_FORBIDDEN owner={owner} name={name} axiom={axiomName}"
      logInfo m!"NORMAL_FULL013_OWN_DECL owner={owner} name={name} private={isPrivateName name}"
    logInfo m!"NORMAL_FULL013_OWNER_PASS owner={owner} declarations={own.length} theorems={theoremCount} definitions={definitionCount} private={privateCount} new_axioms=0 forbidden_dependencies=0"
  logInfo m!"NORMAL_FULL013_COVERAGE formal_modules={formal.size} total_modules={env.header.modules.size} new_owners=2 audited_declarations={declarations.length} typed_examples=5 interface_private_body_audit=separate old_axiom_collectors=0"
  logInfo "FULL_NORMAL_FACADE_B23_L01_PASS"
