module
public import RootPaper_Reference_ChargedHistory009

/-! The measured snapshot and kernel consume the values returned by their
charged traversals. Their counters are generated by those same recursions.
Arithmetic/DFS leaves remain the already recorded closed primitive calls. -/
@[expose] public section
set_option autoImplicit false
set_option warningAsError true
namespace RootPaper.Reference.Charged
open PaperProofs.Common PaperProofs.Statistics PaperProofs.Common.Native
open RootPaper.Reference
variable {I : Instance}

def snapshotCalculation (cache : ReferenceReplayCache I) : Snapshot I×Nat :=
  let cursor:=lengthOf eventAdvance cache.seen
  let actions:=lengthOf eventAction cache.seen
  let allocated:=used cache.seen
  if live : cursor.1<I.stageCount then
    let stage : I.Stage:=⟨cursor.1,live⟩
    let written:=lastOf (eventWrite stage) cache.seen
    let reported:=lastOf (eventReport stage) cache.seen
    let observations:=collect (eventObservation stage) cache.seen
    (⟨some stage,cursor.1,actions.1,allocated.1,written.1,reported.1,observations.1⟩,
      cursor.2+actions.2+allocated.2+written.2+reported.2+observations.2+16)
  else
    (⟨none,cursor.1,actions.1,allocated.1,none,none,[]⟩,cursor.2+actions.2+allocated.2+12)

theorem snapshotCalculation_value (cache : ReferenceReplayCache I) :
    (snapshotCalculation cache).1=RootPaper.Reference.snapshot cache := by
  have cursor:=(lengthOf_spec eventAdvance cache.seen).1
  have actions:=(lengthOf_spec eventAction cache.seen).1
  have allocated:=used_value cache.seen
  have writes (stage : I.Stage):=(lastOf_spec (eventWrite stage) cache.seen).1
  have reports (stage : I.Stage):=(lastOf_spec (eventReport stage) cache.seen).1
  simp only [snapshotCalculation,cursor,actions,allocated,RootPaper.Reference.snapshot,
    historyCursor,historyActions]
  by_cases live : (cache.seen.filterMap eventAdvance).length<I.stageCount
  · have stage : referenceReplayStage I cache=some ⟨_,live⟩ := by
      unfold referenceReplayStage historyCursor
      exact dite_eq_left live
    rw [stage]
    simp only [dite_eq_left live,writes,reports,collect_value,historyWrite,historyReport,historyObservations]
  · have stage : referenceReplayStage I cache=none := by
      unfold referenceReplayStage historyCursor
      exact dite_eq_right live
    rw [stage]
    simp only [dite_eq_right live]

theorem snapshotCalculation_work (cache : ReferenceReplayCache I) :
    (snapshotCalculation cache).2≤(3*I.toolCount+80)*(cache.seen.length+1) := by
  have cursor:=(lengthOf_spec eventAdvance cache.seen).2
  have actions:=(lengthOf_spec eventAction cache.seen).2
  have allocated:=used_work cache.seen
  dsimp only [snapshotCalculation]
  split_ifs with live
  · have writes:=(lastOf_spec (eventWrite (⟨_,live⟩ : I.Stage)) cache.seen).2
    have reports:=(lastOf_spec (eventReport (⟨_,live⟩ : I.Stage)) cache.seen).2
    have observations:=collect_work (eventObservation (⟨_,live⟩ : I.Stage)) cache.seen
    nlinarith
  · nlinarith

def budgetCalculation (initial : Rat) : List ReferenceBudgetEvent→(Option Rat×List (ScalarCall I))×Nat
  | [] => ((some initial,[]),1)
  | event::rest =>
      let front:=budgetStepWork (I:=I) event.1 event.2 initial
      match front.1 with
      | none => ((none,front.2),front.2.length+3)
      | some child =>
          let tail:=budgetCalculation child rest
          ((tail.1.1,front.2++tail.1.2),front.2.length+tail.2+4)

theorem budgetCalculation_value (initial : Rat) (events : List ReferenceBudgetEvent) :
    (budgetCalculation (I:=I) initial events).1=budgetWork initial events := by
  induction events generalizing initial with
  | nil => rfl
  | cons event rest ih =>
      dsimp only [budgetCalculation,budgetWork]
      cases (budgetStepWork (I:=I) event.1 event.2 initial).1
      · rfl
      · dsimp only;rw [ih]

theorem budgetCalculation_work (initial : Rat) (events : List ReferenceBudgetEvent) :
    (budgetCalculation (I:=I) initial events).2≤8*(events.length+1) := by
  induction events generalizing initial with
  | nil => simp [budgetCalculation]
  | cons event rest ih =>
      have front:=budgetStepWork_calls (I:=I) event.1 event.2 initial
      dsimp only [budgetCalculation]
      cases next : (budgetStepWork (I:=I) event.1 event.2 initial).1 with
      | none => simp only [List.length_cons];omega
      | some child =>
          have tail:=ih child
          simp only [List.length_cons]
          omega

def kindCalculation (I : Instance) (available : Finset I.Tool) (stage : I.Stage) (allocated : Finset I.Tool) :
    KindWork I×Nat :=
  let remaining:=difference available allocated
  let root:=query I stage.val remaining.1
  let call : RankCall I:=⟨stage.val,remaining.1,root.transitions⟩
  match root.pick with
  | none => (⟨referenceCaseOfRanks root.rank 0,none,[call]⟩,remaining.2+12)
  | some tool =>
      let childRemaining:=difference remaining.1 {tool}
      let child:=query I (stage.val+1) childRemaining.1
      (⟨referenceCaseOfRanks root.rank child.rank,some tool,
        [call,⟨stage.val+1,childRemaining.1,child.transitions⟩]⟩,remaining.2+childRemaining.2+16)

theorem kindCalculation_value (available : Finset I.Tool) (stage : I.Stage) (allocated : Finset I.Tool) :
    (kindCalculation I available stage allocated).1=kindWork I available stage allocated := by
  have child (remaining : Finset I.Tool) (tool : I.Tool) : (difference remaining {tool}).1=remaining.erase tool := by
    rw [difference_value]
    ext candidate
    simp [and_comm]
  simp only [kindCalculation,difference_value,kindWork]
  cases (query I stage.val (available\allocated)).pick with
  | none => rfl
  | some tool =>
      dsimp only
      have erase : (available\allocated)\{tool}=(available\allocated).erase tool := by ext candidate;simp [and_comm]
      rw [erase]

theorem kindCalculation_work (available : Finset I.Tool) (stage : I.Stage) (allocated : Finset I.Tool) :
    (kindCalculation I available stage allocated).2≤2*(6*I.toolCount+12)*(I.toolCount+1)+16 := by
  have remaining:=difference_work available allocated
  dsimp only [kindCalculation]
  cases picked : (query I stage.val (difference available allocated).1).pick
  · dsimp only;nlinarith
  · rename_i tool
    dsimp only
    have child:=difference_work (difference available allocated).1 {tool}
    nlinarith

def kernelCalculation (available : Finset I.Tool) (budget : Rat) (cache : ReferenceReplayCache I)
    (view : Snapshot I) : Kernel I×Nat :=
  let current:=budgetCalculation (I:=I) (budget/2) cache.events
  let reports:=count cache.events
  match view.stage with
  | none => (⟨none,none,current.1.1,none,[],.half budget::current.1.2⟩,current.2+reports.2+12)
  | some stage =>
      let allocated:=used cache.entryHistory
      let rank:=kindCalculation I available stage allocated.1
      let target : Option Rat×List (ScalarCall I):=
        if cache.halted || decide (cache.phase≠.testing) then (none,[]) else
          match rank.1.classification,current.1.1 with
          | some kind,some risk => if 0<risk ∧ risk≤1/4 ∧ reports.1≤I.stageCount
              then targetWork kind risk else (none,[])
          | _,_ => (none,[])
      (⟨rank.1.classification,rank.1.repair,current.1.1,target.1,rank.1.ranks,
        .half budget::current.1.2++target.2⟩,current.2+reports.2+allocated.2+rank.2+32)

theorem kernelCalculation_value (available : Finset I.Tool) (budget : Rat) (cache : ReferenceReplayCache I)
    (view : Snapshot I) (actual : view=RootPaper.Reference.snapshot cache) :
    (kernelCalculation available budget cache view).1=RootPaper.Reference.kernel I available budget cache := by
  subst view
  simp only [kernelCalculation,budgetCalculation_value,(count_spec cache.events).1,snapshot_stage]
  cases current : referenceReplayStage I cache
  · simp only [RootPaper.Reference.kernel,current]
  · simp only [used_value,kindCalculation_value,RootPaper.Reference.kernel,current]
    rfl

theorem kernelCalculation_work (available : Finset I.Tool) (budget : Rat) (cache : ReferenceReplayCache I)
    (view : Snapshot I) :
    (kernelCalculation available budget cache view).2≤
      16*(cache.events.length+1)+(3*I.toolCount+6)*(cache.entryHistory.length+1)+
        2*(6*I.toolCount+12)*(I.toolCount+1)+64 := by
  have budgetWork:=budgetCalculation_work (I:=I) (budget/2) cache.events
  have reports:=(count_spec cache.events).2
  dsimp only [kernelCalculation]
  cases view.stage
  · dsimp only;omega
  · rename_i stage
    dsimp only
    have allocated:=used_work cache.entryHistory
    have ranks:=kindCalculation_work available stage (used cache.entryHistory).1
    nlinarith

end RootPaper.Reference.Charged
