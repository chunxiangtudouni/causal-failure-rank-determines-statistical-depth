module

public import Paid.PDROC_BitVM_Log_InputLoad_060

set_option autoImplicit false
set_option warningAsError true
set_option maxHeartbeats 2800000

@[expose] public section

namespace PDROC.BitVM.Log.InputLoad

open Turing PaperProofs.Paid.Computation PaperProofs.Paid.Parameters
open PDROC.BitVM.Native PDROC.BitVM.Kernel.RegisterGlobal

/-! Literal and actual Bool comparison return into this ONE opcode program.
The candidate word is generated by real constant pushes, not supplied by a
whole-run numeric oracle. Query27 emptiness is produced before the loop. -/

theorem literal_return (core : Bool) (pointer destination : Register) (field : Fin 13)
    (contents : Stack → List Bool) (store : Store) (scratch : contents 28 = []) :
    ∃ run : List SourceState,
      run.head? = some (⟨some (literalLabel field InputLiteral.startLabel), (store, ()), contents⟩ : SourceState) ∧
      run.IsChain (fun a b => TM2.step (sourceProgram core pointer destination) a = some b) ∧
      run.getLast? = some (⟨some (compareLabel field InputCompare.startLabel), (BankHeader.finished store, ()),
        Function.update contents 24 (InputLiteral.word field)⟩ : SourceState) ∧
      run.length = (contents 24).length + 3 := by
  obtain ⟨source, sourceFinal, sourceHead, sourceChain, sourceLast, sourceHalt, sourceDone, sourceVar, sourceData, sourceLength⟩ :=
    InputLiteral.runs field contents store scratch
  obtain ⟨run, after, head, chain, last, returned, data, saved, length⟩ :=
    Inline.actual_return_trace (literalLabel field) (compareLabel field InputCompare.startLabel) (InputLiteral.program field)
      (sourceProgram core pointer destination) (literal_agrees core pointer destination field) source
      (⟨some InputLiteral.startLabel, store, contents⟩ : InputLiteral.State) sourceFinal () sourceHead sourceChain sourceLast sourceHalt
  have finalVar : after.var = (BankHeader.finished store, ()) := saved.trans (congrArg (fun vars : Store => (vars, ())) sourceVar)
  have finalData : after.stk = Function.update contents 24 (InputLiteral.word field) := data.trans sourceData
  have afterEq : after = (⟨some (compareLabel field InputCompare.startLabel), (BankHeader.finished store, ()),
      Function.update contents 24 (InputLiteral.word field)⟩ : SourceState) := by
    rcases after with ⟨label, vars, current⟩
    change label = some (compareLabel field InputCompare.startLabel) at returned
    change vars = (BankHeader.finished store, ()) at finalVar
    change current = Function.update contents 24 (InputLiteral.word field) at finalData
    subst label; subst vars; subst current
    rfl
  refine ⟨run, head, chain, ?_, length.trans sourceLength⟩
  simpa only [afterEq] using last

theorem compare_return (core : Bool) (pointer destination : Register) (field : Fin 13) (query : ℕ)
    (contents : Stack → List Bool) (store : Store)
    (address : contents 24 = InputLiteral.word field) (queryValue : contents 26 = encodeNatBits query) (savedWord : contents 27 = []) :
    ∃ (run : List SourceState) (vars : Store),
      run.head? = some (⟨some (compareLabel field InputCompare.startLabel), (store, ()), contents⟩ : SourceState) ∧
      run.IsChain (fun a b => TM2.step (sourceProgram core pointer destination) a = some b) ∧
      run.getLast? = some (⟨some (decideLabel field), (vars, ()), InputCompare.compared contents⟩ : SourceState) ∧
      vars.1 = store.1 ∧ Query.equality vars.2.1 = decide (field.val = query) ∧
      Query.recordTag vars.2.1 = Query.recordTag store.2.1 ∧ run.length ≤ 4 * natBits field.val + 8 := by
  obtain ⟨source, sourceFinal, sourceHead, sourceChain, sourceLast, sourceHalt, sourceDone,
    sourceSaved, sourceFlag, sourceTag, sourceData, sourceLength⟩ :=
    InputCompare.runs field.val query contents store address queryValue savedWord
  obtain ⟨run, after, head, chain, last, returned, data, saved, length⟩ :=
    Inline.actual_return_trace (compareLabel field) (decideLabel field) InputCompare.program
      (sourceProgram core pointer destination) (compare_agrees core pointer destination field) source
      (⟨some InputCompare.startLabel, store, contents⟩ : InputCompare.State) sourceFinal () sourceHead sourceChain sourceLast sourceHalt
  have finalVar : after.var = (sourceFinal.var, ()) := saved
  have finalData : after.stk = InputCompare.compared contents := data.trans sourceData
  have afterEq : after = (⟨some (decideLabel field), (sourceFinal.var, ()), InputCompare.compared contents⟩ : SourceState) := by
    rcases after with ⟨label, vars, current⟩
    change label = some (decideLabel field) at returned
    change vars = (sourceFinal.var, ()) at finalVar
    change current = InputCompare.compared contents at finalData
    subst label; subst vars; subst current
    rfl
  refine ⟨run, sourceFinal.var, head, chain, ?_, sourceSaved, sourceFlag, sourceTag, ?_⟩
  · simpa only [afterEq] using last
  · rw [length]; exact sourceLength

theorem copy_return (core : Bool) (pointer destination : Register) (field : Fin 13)
    (contents : Stack → List Bool) (store : Store) (scratch : contents 24 = []) :
    ∃ run : List SourceState,
      run.head? = some (⟨some (copyLabel field 0), (store, ()), contents⟩ : SourceState) ∧
      run.IsChain (fun a b => TM2.step (sourceProgram core pointer destination) a = some b) ∧
      run.getLast? = some (⟨some (cleanLabel 0), (HeapLoad.cleared store, ()),
        Function.update contents (registerSlot destination) (contents (BankDrain.bankSlot field))⟩ : SourceState) ∧
      run.length = (contents (registerSlot destination)).length + 2 * (contents (BankDrain.bankSlot field)).length + 6 := by
  obtain ⟨source, sourceFinal, sourceHead, sourceChain, sourceLast, sourceHalt, sourceDone, sourceVar, sourceData, sourceLength⟩ :=
    InputCopy.runs field destination (⟨some 0, store, contents⟩ : InputCopy.State) rfl scratch
  obtain ⟨run, after, head, chain, last, returned, data, saved, length⟩ :=
    Inline.actual_return_trace (copyLabel field) (cleanLabel 0) (InputCopy.program field destination)
      (sourceProgram core pointer destination) (copy_agrees core pointer destination field) source
      (⟨some 0, store, contents⟩ : InputCopy.State) sourceFinal () sourceHead sourceChain sourceLast sourceHalt
  have finalVar : after.var = (HeapLoad.cleared store, ()) := saved.trans (congrArg (fun vars : Store => (vars, ())) sourceVar)
  have finalData : after.stk = Function.update contents (registerSlot destination) (contents (BankDrain.bankSlot field)) := data.trans sourceData
  have afterEq : after = (⟨some (cleanLabel 0), (HeapLoad.cleared store, ()),
      Function.update contents (registerSlot destination) (contents (BankDrain.bankSlot field))⟩ : SourceState) := by
    rcases after with ⟨label, vars, current⟩
    change label = some (cleanLabel 0) at returned
    change vars = (HeapLoad.cleared store, ()) at finalVar
    change current = Function.update contents (registerSlot destination) (contents (BankDrain.bankSlot field)) at finalData
    subst label; subst vars; subst current
    rfl
  refine ⟨run, head, chain, ?_, length.trans sourceLength⟩
  simpa only [afterEq] using last

theorem candidate_compare_return (core : Bool) (pointer destination : Register) (field : Fin 13) (query : ℕ)
    (contents : Stack → List Bool) (store : Store)
    (emptyAddress : contents 24 = []) (queryValue : contents 26 = encodeNatBits query)
    (savedWord : contents 27 = []) (scratch : contents 28 = []) :
    ∃ (run : List SourceState) (vars : Store),
      run.head? = some (⟨some (literalLabel field InputLiteral.startLabel), (store, ()), contents⟩ : SourceState) ∧
      run.IsChain (fun a b => TM2.step (sourceProgram core pointer destination) a = some b) ∧
      run.getLast? = some (⟨some (decideLabel field), (vars, ()), contents⟩ : SourceState) ∧
      vars.1 = (BankHeader.finished store).1 ∧ Query.equality vars.2.1 = decide (field.val = query) ∧
      run.length ≤ 4 * natBits field.val + 12 := by
  obtain ⟨left, leftHead, leftChain, leftLast, leftLength⟩ := literal_return core pointer destination field contents store scratch
  let written := Function.update contents 24 (InputLiteral.word field)
  have address : written 24 = InputLiteral.word field := by simp only [written, Function.update_self]
  have actualQuery : written 26 = encodeNatBits query := by
    simpa only [written, Function.update_of_ne (by decide : (26 : Stack) ≠ 24)] using queryValue
  have actualSaved : written 27 = [] := by
    simpa only [written, Function.update_of_ne (by decide : (27 : Stack) ≠ 24)] using savedWord
  obtain ⟨right, vars, rightHead, rightChain, rightLast, saved, flag, tag, rightLength⟩ :=
    compare_return core pointer destination field query written (BankHeader.finished store) address actualQuery actualSaved
  have dataExact : InputCompare.compared written = contents := by
    funext index
    simp only [InputCompare.compared, written, Function.update_idem]
    by_cases at27 : index = 27
    · subst index; rw [Function.update_self]; exact savedWord.symm
    · rw [Function.update_of_ne at27]
      by_cases at24 : index = 24
      · subst index; rw [Function.update_self]; exact emptyAddress.symm
      · rw [Function.update_of_ne at24]
  let middle : SourceState := ⟨some (compareLabel field InputCompare.startLabel), (BankHeader.finished store, ()), written⟩
  let run := left ++ right.tail
  have head : run.head? = some (⟨some (literalLabel field InputLiteral.startLabel), (store, ()), contents⟩ : SourceState) := by
    simp only [run, List.head?_append, leftHead, Option.some_or]
  have chain : run.IsChain (fun a b => TM2.step (sourceProgram core pointer destination) a = some b) :=
    TwoStack.join_chain left right middle leftChain rightChain leftLast rightHead
  have notOne : right.length ≠ 1 := by
    intro one
    obtain ⟨single, singleton⟩ := List.length_eq_one_iff.mp one
    have firstEqual : single = middle := Option.some.inj (by simpa only [singleton, List.head?_cons] using rightHead)
    have lastEqual : single = (⟨some (decideLabel field), (vars, ()), InputCompare.compared written⟩ : SourceState) :=
      Option.some.inj (by simpa only [singleton, List.getLast?_singleton] using rightLast)
    have labels := congrArg (fun state : SourceState => state.l) (firstEqual.symm.trans lastEqual)
    simp only [middle, compareLabel, decideLabel] at labels
    have impossible := Option.some.inj labels
    cases impossible
  have last : run.getLast? = some (⟨some (decideLabel field), (vars, ()), contents⟩ : SourceState) := by
    simp only [run, List.getLast?_append, List.getLast?_tail, notOne, ↓reduceIte, rightLast, Option.some_or, dataExact]
  refine ⟨run, vars, head, chain, last, saved, flag, ?_⟩
  have leftExact : left.length = 3 := by simpa only [emptyAddress, List.length_nil, Nat.zero_add] using leftLength
  simp only [run, List.length_append, List.length_tail]
  omega

end PDROC.BitVM.Log.InputLoad
